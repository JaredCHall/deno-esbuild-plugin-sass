{
  "compilerOptions": {
    "lib": ["dom", "deno.ns"]
  },
  "imports": {
    "@esbuild": "https://deno.land/x/esbuild/mod.js",
    "@deno-plugins": "jsr:@luca/esbuild-deno-loader",
    "deno-esbuild-plugin-sass": "./mod.ts",
    "lit": "https://esm.sh/lit@3.3.0",
    "lit-decorators": "https://esm.sh/lit@3.3.0/decorators"
  },
  "tasks": {
    "build": "deno run -A examples/build.ts",
    "test": "deno test --allow-read --allow-run --allow-env --allow-write",
    "fetch:sass": "deno run --allow-net --allow-write --allow-run --allow-read scripts/fetch_sass.ts",
    "fetch:latest": "deno run --allow-net scripts/latest-sass-version.ts"
  }
}